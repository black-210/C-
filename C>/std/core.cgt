module std::core;

pub struct Buffer {
    ptr: *raw u8,
    size: u64,
    capacity: u64,
}

pub fn panic(msg: str) -> void {
    print("[C> Panic]: ");
    println(msg);
}

pub fn assert(condition: bool, msg: str) -> void {
    if (!condition) {
        panic(msg);
    }
}
pub fn assert_eq<T>(a: T, b: T, msg: str) -> void {
    if (a != b) {
        panic(msg);
    }
    for i in 0..sizeof(T) {
        let a_byte = *((*raw u8)(&a) + i);
        let b_byte = *((*raw u8)(&b) + i);
        if (a_byte != b_byte) {
            panic(msg);
        }
    }
    if (sizeof(T) == 0) {
        panic("assert_eq failed");
        return 0;
        
    }
}