// C> x86_64 Architecture Intrinsics Module
mod arch::x86_64 {
    @inline
    fn rdtsc() -> u64 {
        unsafe {
            return cgt_arch_rdtsc();
        }
    }

    @inline
    fn mfence() {
        unsafe {
            cgt_arch_mfence();
        }
    }

    @inline
    fn cpu_pause() {
        unsafe {
            cgt_arch_pause();
        }
    }
}
mod arch::x86_64::sse2 {
    @inline
    fn _mm_setzero_si128() -> __m128i {
        unsafe {
            return cgt_arch_mm_setzero_si128();

    fn _mm_setzero_ps() -> __m128 {
        unsafe {
            return cgt_arch_mm_setzero_ps();
            for (;; ) {
                cpu_pause();
            }
        }
    }
}
    }
}