{
  "Say Output (Universal)": {
    "prefix": "say",
    "body": [
      "say \"${1:Hello, World!}\";"
    ],
    "description": "Universal output to console (simpler than Python print)"
  },
  "Ask Input (Universal)": {
    "prefix": "ask",
    "body": [
      "ask \"${1:What is your name? }\" -> ${2:user_name};",
      "say \"Hello, \", ${2:user_name};"
    ],
    "description": "Universal user input prompt with direct arrow binding"
  },
  "Repeat Loop": {
    "prefix": "repeat",
    "body": [
      "repeat ${1:5} times {",
      "    ${0:say \"Step\";}",
      "}"
    ],
    "description": "Clean repetition loop without index boilerplate"
  },
  "Every Iteration": {
    "prefix": "every",
    "body": [
      "every ${1:item} in ${2:collection} {",
      "    ${0:say item;}",
      "}"
    ],
    "description": "Universal clean collection iteration"
  },
  "Whenever Otherwise Branch": {
    "prefix": "whenever",
    "body": [
      "whenever ${1:condition} {",
      "    ${2:say \"True\";}",
      "} otherwise {",
      "    ${3:say \"False\";}",
      "}"
    ],
    "description": "Natural declarative condition branch"
  },
  "Define Function": {
    "prefix": "define",
    "body": [
      "define ${1:name}(${2:params}) {",
