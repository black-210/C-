{
  "name": "C> Vibrant Light Theme",
  "type": "light",
  "colors": {
    "editor.background": "#f8fafc",
    "editor.foreground": "#0f172a",
    "activityBar.background": "#f1f5f9",
    "sideBar.background": "#f8fafc",
    "statusBar.background": "#0284c7",
    "statusBar.foreground": "#ffffff",
    "editorLineNumber.foreground": "#94a3b8",
    "editorLineNumber.activeForeground": "#0284c7",
    "editorCursor.foreground": "#0284c7",
    "editor.selectionBackground": "#cbd5e188",
    "editor.lineHighlightBackground": "#f1f5f988"
  },
  "tokenColors": [
    {
      "name": "C> Comments",
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "comment.line.double-slash.cgt",
        "comment.block.cgt"
      ],
      "settings": {
        "foreground": "#64748b",
        "fontStyle": "italic"
      }
    },
    {
      "name": "C> Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.double.cgt",
        "string.quoted.single.cgt"
      ],
      "settings": {
        "foreground": "#15803d",
        "fontStyle": "normal"
      }
    },
    {
      "name": "C> Numbers",
      "scope": [
        "constant.numeric",
        "constant.numeric.hex.cgt",
        "constant.numeric.binary.cgt",
        "constant.numeric.float.cgt",
        "constant.numeric.decimal.cgt"
      ],
      "settings": {
        "foreground": "#c2410c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "C> Beginner Universal Keywords",
      "scope": [
        "keyword.control.beginner.cgt",
        "keyword.beginner.cgt",
        "support.function.beginner.cgt"
      ],
      "settings": {
        "foreground": "#b45309",
        "fontStyle": "bold"
      }
    },
    {
      "name": "C> Low-Level & Bare-Metal Hardware",
      "scope": [
        "keyword.other.hardware.cgt",
        "keyword.other.lowlevel.cgt",
        "keyword.other.kernel.cgt",
        "keyword.hardware.cgt",
        "storage.modifier.hardware.cgt"
      ],
      "settings": {
        "foreground": "#be123c",
        "fontStyle": "bold"
      }
    },
    {
      "name": "C> Autonomous Self-Host & Direct Native",
      "scope": [
        "keyword.control.selfhost.cgt",
        "keyword.selfhost.cgt"
      ],
      "settings": {
        "foreground": "#0369a1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "C> Pipeline & Dataflow Streaming",
      "scope": [
        "keyword.control.flow.cgt",
        "keyword.pipeline.cgt"
      ],
      "settings": {
        "foreground": "#7e22ce",
        "fontStyle": "bold"
      }
    },
    {
      "name": "C> Async & Concurrency",
      "scope": [
        "keyword.control.async.cgt",
        "keyword.control.concurrency.cgt"
      ],
      "settings": {
        "foreground": "#6b21a8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "C> Safety Guards",
      "scope": [
        "keyword.control.guard.cgt"
      ],
      "settings": {
        "foreground": "#047857",
        "fontStyle": "bold"
      }
    },
    {
      "name": "C> Contracts & Specifications",
      "scope": [
        "keyword.control.contract.cgt"
      ],
      "settings": {
        "foreground": "#0f766e",
        "fontStyle": "bold"
      }
    },
    {
      "name": "C> Control Flow Keywords",
      "scope": [
        "keyword.control",
        "keyword.control.cgt"
      ],
      "settings": {
        "foreground": "#9333ea",
        "fontStyle": "bold"
      }
    },
    {
      "name": "C> Declarations & Modifiers",
      "scope": [
        "keyword.declaration.cgt",
        "storage.type.function",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#4338ca",
        "fontStyle": "bold"
      }
    },
    {
      "name": "C> Builtin Types",
      "scope": [
        "storage.type",
        "storage.type.primitive.cgt",
        "storage.type.hardware.cgt"
      ],
      "settings": {
        "foreground": "#0e7490",
        "fontStyle": "normal"
      }
    },
    {
      "name": "C> Functions",
      "scope": [
        "entity.name.function",
        "entity.name.function.cgt",
        "support.function",
        "support.function.cgt"
      ],
      "settings": {
        "foreground": "#1d4ed8",
        "fontStyle": "normal"
      }
    },
    {
      "name": "C> Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#db2777",
        "fontStyle": "bold"
      }
    }
  ]
}
